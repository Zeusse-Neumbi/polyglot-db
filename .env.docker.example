APP_NAME=Polyglot DB
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost

# MariaDB (Read/Write Split)
DB_CONNECTION=mariadb
DB_WRITE_HOST=mariadb-primary
DB_READ_HOST=mariadb-replica
DB_HOST=mariadb-primary
DB_PORT=3306
DB_DATABASE=tp_bd
DB_USERNAME=laravel
DB_PASSWORD=secret

# MongoDB Replica Set
MONGO_DSN=mongodb://mongo-primary:27017,mongo-secondary:27017/?replicaSet=rs0
DB_MONGO_HOST=mongo-primary
DB_MONGO_PORT=27017
DB_MONGO_DATABASE=social_network_data

# Redis (Separated instances)
REDIS_CLIENT=phpredis
REDIS_HOST=redis-cache
REDIS_PORT=6379
REDIS_CACHE_HOST=redis-cache
REDIS_QUEUE_HOST=redis-queue
REDIS_QUEUE_PORT=6379

# Queue
QUEUE_CONNECTION=redis

# Session
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Cache
CACHE_STORE=redis
