    "liveNow": false,
    "panels": [
        {
            "title": "Database Comparison",
            "type": "row",
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 0
            }
        },
        {
            "title": "MariaDB - Queries/sec",
            "type": "stat",
            "datasource": "Prometheus",
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 0,
                "y": 1
            },
            "targets": [
                {
                    "expr": "rate(mysql_global_status_queries[1m])",
                    "legendFormat": "Queries/sec"
                }
            ],
            "options": {
                "colorMode": "value",
                "graphMode": "area"
            }
        },
        {
            "title": "MongoDB - Operations/sec",
            "type": "stat",
            "datasource": "Prometheus",
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 6,
                "y": 1
            },
            "targets": [
                {
                    "expr": "sum(rate(mongodb_ss_opcounters[1m]))",
                    "legendFormat": "Ops/sec"
                }
            ],
            "options": {
                "colorMode": "value",
                "graphMode": "area"
            }
        },
        {
            "title": "Redis - Commands/sec",
            "type": "stat",
            "datasource": "Prometheus",
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 12,
                "y": 1
            },
            "targets": [
                {
                    "expr": "rate(redis_commands_processed_total[1m])",
                    "legendFormat": "Cmds/sec"
                }
            ],
            "options": {
                "colorMode": "value",
                "graphMode": "area"
            }
        },
        {
            "title": "Active Connections",
            "type": "stat",
            "datasource": "Prometheus",
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 18,
                "y": 1
            },
            "targets": [
                {
                    "expr": "mysql_global_status_threads_connected",
                    "legendFormat": "MariaDB"
                },
                {
                    "expr": "mongodb_ss_connections{conn_type=\"current\"}",
                    "legendFormat": "MongoDB"
                }
            ]
        },
        {
            "title": "Replication Status",
            "type": "row",
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 5
            }
        },
        {
            "title": "MariaDB Replication Lag (seconds)",
            "type": "gauge",
            "datasource": "Prometheus",
            "gridPos": {
                "h": 6,
                "w": 8,
                "x": 0,
                "y": 6
            },
            "targets": [
                {
                    "expr": "mysql_slave_status_seconds_behind_master",
                    "legendFormat": "Lag"
                }
            ],
            "options": {
                "minValue": 0,
                "maxValue": 60
            },
            "fieldConfig": {
                "defaults": {
                    "thresholds": {
                        "steps": [
                            {
                                "value": 0,
                                "color": "green"
                            },
                            {
                                "value": 5,
                                "color": "yellow"
                            },
                            {
                                "value": 30,
                                "color": "red"
                            }
                        ]
                    }
                }
            }
        },
        {
            "title": "MongoDB Replica Set Members",
            "type": "stat",
            "datasource": "Prometheus",
            "gridPos": {
                "h": 6,
                "w": 8,
                "x": 8,
                "y": 6
            },
            "targets": [
                {
                    "expr": "mongodb_rs_members_health",
                    "legendFormat": "{{member}}"
                }
            ]
        },
        {
            "title": "Redis Memory Usage",
            "type": "gauge",
            "datasource": "Prometheus",
            "gridPos": {
                "h": 6,
                "w": 8,
                "x": 16,
                "y": 6
            },
            "targets": [
                {
                    "expr": "redis_memory_used_bytes / 1024 / 1024",
                    "legendFormat": "MB Used"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "MB"
                }
            }
        },
        {
            "title": "Performance Over Time",
            "type": "row",
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 12
            }
        },
        {
            "title": "Database Operations Timeline",
            "type": "timeseries",
            "datasource": "Prometheus",
            "gridPos": {
                "h": 8,
                "w": 24,
                "x": 0,
                "y": 13
            },
            "targets": [
                {
                    "expr": "rate(mysql_global_status_queries[1m])",
                    "legendFormat": "MariaDB Queries"
                },
                {
                    "expr": "sum(rate(mongodb_ss_opcounters[1m]))",
                    "legendFormat": "MongoDB Ops"
                },
                {
                    "expr": "rate(redis_commands_processed_total[1m])",
                    "legendFormat": "Redis Commands"
                }
            ],
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "right"
                }
            }
        }
    ],
    "refresh": "5s",
