{
    "annotations": {
        "list": []
    },
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 0,
    "id": null,
    "links": [],
    "liveNow": false,
    "panels": [
        {
            "title": "Host System Performance",
            "type": "row",
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 0
            }
        },
        {
            "title": "Load Average (1m)",
            "type": "gauge",
            "datasource": "Prometheus",
            "gridPos": {
                "h": 6,
                "w": 8,
                "x": 0,
                "y": 1
            },
            "targets": [
                {
                    "expr": "node_load1",
                    "legendFormat": "Load 1m"
                }
            ]
        },
        {
            "title": "CPU Usage",
            "type": "timeseries",
            "datasource": "Prometheus",
            "gridPos": {
                "h": 6,
                "w": 16,
                "x": 8,
                "y": 1
            },
            "targets": [
                {
                    "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)",
                    "legendFormat": "CPU Used %"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "percent",
                    "max": 100
                }
            }
        },
        {
            "title": "Available Memory",
            "type": "stat",
            "datasource": "Prometheus",
            "gridPos": {
                "h": 4,
                "w": 8,
                "x": 0,
                "y": 7
            },
            "targets": [
                {
                    "expr": "node_memory_MemAvailable_bytes",
                    "legendFormat": "Available"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "bytes"
                }
            }
        },
        {
            "title": "Host Network Traffic",
            "type": "timeseries",
            "datasource": "Prometheus",
            "gridPos": {
                "h": 8,
                "w": 16,
                "x": 8,
                "y": 7
            },
            "targets": [
                {
                    "expr": "rate(node_network_receive_bytes_total[1m])",
                    "legendFormat": "RX {{device}}"
                },
                {
                    "expr": "rate(node_network_transmit_bytes_total[1m])",
                    "legendFormat": "TX {{device}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "bps"
                }
            }
        }
    ],
    "refresh": "5s",
    "schemaVersion": 38,
    "style": "dark",
    "tags": [
